meta {
  name: Transfer invalid input
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/transfers
  body: json
  auth: none
}

body:json {
  {
    "fromAccountId": 1,
    "toAccountId": 1,
    "amount": "0"
  }
}

assert {
  res.status: eq 400
  res.body.error.code: eq VALIDATION_ERROR
  res.body.error.details[0].field: eq amount
  res.body.error.details[0].issue: eq too_small
}
