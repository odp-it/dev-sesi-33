# Salin menjadi .env lalu isi. File .env tidak di-commit.
DB_USER=ALP_DEV
DB_PASSWORD=ISI_PASSWORD_ALP_DEV
DB_CONNECT_STRING=localhost:1521/FREEPDB1
PORT=3000
# Wajib untuk Sequelize dialect Oracle: proses Node berjalan di UTC.
TZ=UTC
# sql = node-oracledb langsung (sesi 31), orm = Sequelize. npm run dev:sql / dev:orm menimpa nilai ini.
DATA_LAYER=sql
# true = cetak SQL yang dibuat Sequelize
DB_LOG_SQL=false
